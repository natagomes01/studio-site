---
import type { Locale } from '@i18n/index';
import { t, guideHref } from '@i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale).reading;
const href = guideHref();
---
<section class="alb-reading" id="leitura">
  <header class="alb-reading__header reveal">
    <span class="alb-section-eyebrow">{s.eyebrow}</span>
    <h2 class="alb-reading__heading">{s.heading}</h2>
    <hr class="alb-divider" style="margin-top: 24px" />
  </header>

  <a class="alb-reading__card reveal reveal--delay-2" href={href}>
    <span class="alb-reading__kicker">{s.kicker}</span>
    <h3 class="alb-reading__title">{s.title}</h3>
    <p class="alb-reading__body">{s.body}</p>
    <span class="alb-reading__cta">
      {s.cta}
      <svg class="alb-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" stroke-linejoin="miter"/>
      </svg>
    </span>
  </a>
</section>
