---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LangBanner from '@components/LangBanner.astro';
import Nav from '@components/Nav.astro';
import Hero from '@components/Hero.astro';
import ProofBar from '@components/ProofBar.astro';
import PainPoints from '@components/PainPoints.astro';
import Cases from '@components/Cases.astro';
import Protocol from '@components/Protocol.astro';
import Faq from '@components/Faq.astro';
import Reading from '@components/Reading.astro';
import Footer from '@components/Footer.astro';
import WhatsAppFab from '@components/WhatsAppFab.astro';
import SiteSchema from '@components/SiteSchema.astro';

const locale = 'en' as const;
---
<BaseLayout locale={locale}>
  <SiteSchema slot="head" locale={locale} />
  <LangBanner slot="banner" locale={locale} />
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <ProofBar locale={locale} />
    <PainPoints locale={locale} />
    <Cases locale={locale} />
    <Protocol locale={locale} />
    <Faq locale={locale} />
    <Reading locale={locale} />
  </main>
  <Footer locale={locale} />
  <WhatsAppFab locale={locale} />
</BaseLayout>
